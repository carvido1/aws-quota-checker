      "title": "API Gateway quota utilization ($MinQuotaThreashold% and higher)",
      "type": "row"
    },
    {
      "description": "Account and Region level API Gateway quotas fetched by [aws-quota-checker](https://github.com/gravitational/aws-quota-checker), e.g. REST/HTTP API counts, custom domain names, usage plans, API keys, client certificates and VPC links.\n- https://docs.aws.amazon.com/apigateway/latest/developerguide/limits.html\n",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "displayName": "[${__field.labels.region}] ${__field.labels.quota}",
          "fieldMinMax": false,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "percentunit",
          "unitScale": true
        },
        "overrides": []
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "displayMode": "lcd",
